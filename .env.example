# Modelo visible en `ollama list`.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://127.0.0.1:11434

# Directorio al que el agente puede limitar las operaciones de archivo.
# AGENT_WORKSPACE=C:\xampp\htdocs\Sellium Chat LLM Ollama

# Por defecto está activo para este asistente local. Usa false para desactivarlo.
ENABLE_APP_LAUNCH=true

# Voz local. `scripts/download_voice_models.py` descarga estos modelos una única vez.
WHISPER_MODEL_PATH=models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_MODEL_PATH=models/piper/es_ES-sharvard-medium.onnx
# sharvard medium contiene M=0 y F=1.
PIPER_SPEAKER_ID=0
